rules_version = '2';
// Reglas de seguridad del Cotizador Tercio Creativo S.A.S.
// Administradores: leen y escriben todo, y manejan usuarios y ajustes.
// Empleados: crean y editan clientes y cotizaciones; no tocan ajustes ni usuarios.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isActive() { return signedIn() && exists(userPath()) && get(userPath()).data.activo == true; }
    function isAdmin() { return isActive() && get(userPath()).data.rol == 'admin'; }
    function sinConfigurar() { return !exists(/databases/$(database)/documents/sistema/inicial); }

    // Marca de configuración inicial: se crea una sola vez, junto con el primer administrador
    match /sistema/inicial {
      allow read: if true;
      allow create: if signedIn() && sinConfigurar()
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userPath()).data.rol == 'admin';
      allow update, delete: if false;
    }

    // Perfiles de usuario con su rol: solo el administrador los crea y modifica
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && sinConfigurar() && request.resource.data.rol == 'admin');
      allow update, delete: if isAdmin();
    }

    // Nombre de la empresa en la pantalla de ingreso
    match /config/publico {
      allow read: if true;
    }
    // Ajustes, costos y catálogo: todos los usuarios activos leen, solo el administrador cambia
    match /config/{doc} {
      allow read: if isActive();
      allow write: if isAdmin() || (signedIn() && sinConfigurar());
    }

    // Consecutivo de cotizaciones: solo puede subir de uno en uno
    match /contadores/cotizaciones {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ultimo == 1;
      allow update: if isActive() && request.resource.data.ultimo == resource.data.ultimo + 1;
    }

    match /clientes/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isActive() && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin();
    }

    match /cotizaciones/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() || (isActive() && request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() || (isActive() && resource.data.estado == 'borrador');
    }
  }
}
